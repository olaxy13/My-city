datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ListingType {
  event
  restaurant
  facility
}

enum ListingStatus {
  pending
  needs_changes
  approved
  rejected
}

enum AdminRole {
  admin
  super_admin
}

enum CategoryEnum {
  music
  food_drink
  sports
  comedy
  arts_culture
  nightlife
  religious
  education
  lifestyle
  wellness
}

model Listing {
  id              String        @id @default(uuid()) @db.Uuid
  listingType     ListingType
  title           String
  description     String
  category        CategoryEnum
  city            String        @default("Abeokuta")
  neighborhood    String
  address         String?
  latitude        Float?
  longitude       Float?

  thumbnailUrl    String
  images          ListingImage[]
  legalDocumentUrls String[]    @default([]) // Uploaded CAC docs, licenses, business permits

  contactPhone    String?       // WhatsApp / Customer Care Phone
  contactEmail    String?
  externalLink    String?       // External booking / tickets / ordering URL

  submitterName   String
  submitterEmail  String
  submitterPhone  String
  editToken       String?       @unique

  status          ListingStatus @default(pending)
  rejectionReason String?
  adminNotes      String?

  isFeatured      Boolean       @default(false)
  featuredOrder   Int?          @default(0)
  isPublished     Boolean       @default(true)

  eventDetails      EventDetails?
  restaurantDetails RestaurantDetails?
  facilityDetails   FacilityDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, isPublished])
  @@index([listingType, status])
  @@index([category, status])
  @@index([city, status])
  @@index([city, isPublished])
  @@index([isFeatured, featuredOrder])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int      @default(0)

  @@index([listingId, sortOrder])
  @@map("listing_images")
}

model EventDetails {
  id            String   @id @default(uuid()) @db.Uuid
  listingId     String   @unique @db.Uuid
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDateTime DateTime
  endDateTime   DateTime?
  isRecurring   Boolean  @default(false)

  @@index([startDateTime])
  @@map("event_details")
}

model RestaurantDetails {
  id             String  @id @default(uuid()) @db.Uuid
  listingId      String  @unique @db.Uuid
  listing        Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  cuisineType    String
  priceRange     String? // "$", "$$", "$$$", "$$$$"
  operatingHours String?
  menuLink       String?
  cacNumber      String?
  licenseNumber  String?

  @@map("restaurant_details")
}

model FacilityDetails {
  id               String  @id @default(uuid()) @db.Uuid
  listingId        String  @unique @db.Uuid
  listing          Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  facilityCategory String
  emergencyContact String?
  operatingHours   String?
  cacNumber        String?
  licenseNumber    String?

  @@map("facility_details")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(admin)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}
