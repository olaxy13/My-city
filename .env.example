# Server
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Database (PostgreSQL via Supabase or Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/city_discovery?schema=public"

# Authentication
JWT_SECRET=super-secret-city-discovery-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Resend Email Service
RESEND_API_KEY=re_123456789_placeholder
EMAIL_FROM="City Discovery <notifications@resend.dev>"

# Cloudinary (Direct Signed Uploads)
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345
CLOUDINARY_FOLDER=city-discovery
